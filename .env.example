# Copy to .env and fill in. Never commit .env.

# Optional. Enables Ask Summa, AI summaries, AI scam explanations and AI parsing of unusual SMS.
# Everything else works without it. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional overrides
# SUMMA_LLM_MODEL=claude-opus-5-5
# SUMMA_LLM_EFFORT=medium
# DATABASE_URL=sqlite:///backend/data/summa.db      # or postgresql+psycopg://user:pass@host/db
# SUMMA_COOKIE_SECURE=true                          # set to true when served over HTTPS
# SUMMA_SESSION_DAYS=14
# SUMMA_MAX_IMPORT_BYTES=2097152
# SUMMA_CORS_ORIGINS=                               # only needed if the frontend is on another origin
